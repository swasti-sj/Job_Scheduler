{
  "name": "job-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Distributed job scheduler and task queue with exactly-once execution on PostgreSQL + Redis",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "migrate": "tsx src/bin/migrate.ts",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:scheduler": "tsx watch src/bin/scheduler.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "start:api": "node dist/bin/api.js",
    "start:scheduler": "node dist/bin/scheduler.js",
    "start:worker": "node dist/bin/worker.js",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "chaos": "tsx src/chaos/chaos.ts",
    "loadtest": "tsx src/loadtest/run.ts",
    "histogram": "tsx src/loadtest/histogram.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8"
  }
}
