# ---- Postgres ----
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
PG_POOL_MAX=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Process identity ----
NODE_ID=
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
LOG_LEVEL=info

# ---- Leases / claiming ----
LEASE_DURATION_SECONDS=30
CLAIM_BATCH_SIZE=32
CLAIM_CANDIDATES_PER_PRIORITY=64
# Candidates considered per claim = batch * this. Must exceed the number of
# workers claiming a queue concurrently, or SKIP LOCKED starves all but one.
CLAIM_OVERSELECT_FACTOR=8
CLAIM_POLL_INTERVAL_MS=50
CLAIM_POLL_JITTER_MS=25
# Idle poll backs off to this ceiling. Redis wakeups cover enqueues, so this only
# bounds latency for jobs that become ready on their own (retry backoffs).
CLAIM_POLL_MAX_INTERVAL_MS=500

# ---- Aging (effective priority) ----
AGING_INTERVAL_SECONDS=30
AGING_MAX_BOOST=9

# ---- Fair share ----
FAIR_SHARE_ENABLED=true
FAIR_SHARE_MAX_PCT=0.5

# ---- Rate limiting (per queue token bucket) ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=10000
RATE_LIMIT_REFILL_PER_SEC=5000

# ---- Retries ----
BACKOFF_BASE_MS=250
BACKOFF_CAP_MS=60000
DEFAULT_MAX_ATTEMPTS=5

# ---- Circuit breaker (per job_type) ----
BREAKER_ENABLED=true
BREAKER_WINDOW_SECONDS=60
BREAKER_MIN_SAMPLES=20
BREAKER_FAILURE_RATE=0.5
BREAKER_COOLDOWN_SECONDS=60

# ---- Worker liveness ----
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_MISSED_BEATS=3

# ---- Leader election ----
LEADER_LOCK_KEY=911001
LEADER_POLL_INTERVAL_MS=500
REAPER_INTERVAL_MS=1000

# ---- Dashboard websocket backpressure ----
DASHBOARD_RING_SIZE=64
DASHBOARD_MAX_BUFFERED_BYTES=262144
DASHBOARD_BROADCAST_INTERVAL_MS=1000

# ---- Worker process ----
WORKER_CONCURRENCY=8
WORKER_QUEUES=default
SCHEDULER_WS_URL=ws://localhost:3000/worker
